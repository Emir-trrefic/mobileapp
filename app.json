{
  "expo": {
    "name": "mobileapp",
    "slug": "mobileapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icon.png"
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bulundugun mekani bulmak ve orada olan kisileri gostermek icin konumun kullanilir."
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#050A18"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidini açmak için Face ID kullanılır."
        }
      ]
    ],
    "backgroundColor": "#050A18",
    "splash": {
      "image": "./assets/splash-icon.png",
      "imageWidth": 180,
      "resizeMode": "contain",
      "backgroundColor": "#050A18"
    },
    "icon": "./assets/icon.png"
  }
}
