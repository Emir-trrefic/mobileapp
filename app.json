{
  "expo": {
    "name": "Burada",
    "slug": "mobileapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "ios": {
      "supportsTablet": false
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bulundugun mekani bulmak ve orada olan kisileri gostermek icin konumun kullanilir."
        }
      ],
      "expo-status-bar"
    ],
    "backgroundColor": "#081028",
    "splash": {
      "backgroundColor": "#081028",
      "resizeMode": "contain"
    }
  }
}
