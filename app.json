{
  "expo": {
    "name": "rast",
    "slug": "mobileapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.emirkiraz.rast",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Bulunduğun kafeyi bulmak ve check-in yapabilmen için konumun kullanılır. Check-in yokken konumun sunucuya gönderilmez.",
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı seçebilmen için fotoğraflarına erişilir. Sadece seçtiğin fotoğraf yüklenir.",
        "NSFaceIDUsageDescription": "Uygulama kilidini açmak için Face ID kullanılır.",
        "CFBundleDevelopmentRegion": "tr",
        "ITSAppUsesNonExemptEncryption": true,
        "NSLocationAlwaysUsageDescription": "Bulunduğun kafeyi bulmak ve check-in yapabilmen için konumun kullanılır. Check-in yokken konumun sunucuya gönderilmez.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Bulunduğun kafeyi bulmak ve check-in yapabilmen için konumun kullanılır. Check-in yokken konumun sunucuya gönderilmez.",
        "NSMotionUsageDescription": "Konum doğruluğunu artırmak için hareket bilgisi kullanılabilir; bu bilgi cihazdan çıkmaz."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bulunduğun kafeyi bulmak ve check-in yapabilmen için konumun kullanılır. Check-in yokken konumun sunucuya gönderilmez.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#050A18"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidini açmak için Face ID kullanılır."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#050A18"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçebilmen için fotoğraflarına erişilir. Sadece seçtiğin fotoğraf yüklenir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "backgroundColor": "#050A18",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.emirkiraz.rast",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050A18"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "scheme": "rast"
  }
}
